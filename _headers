# Cloudflare Pages header rules.
#
# Default asset caching is 4 hours, which means a push can take that long to
# reach visitors — including a fix made shortly before it's needed. These
# files are small and unversioned, so trade a little bandwidth for changes
# that actually show up.

/js/*
  Cache-Control: public, max-age=60, must-revalidate

/css/*
  Cache-Control: public, max-age=60, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
